APP_NAME=DARMOIS
APP_ENV=production
# Throwaway key generated for this deployment. Replace it with your own:
#   docker compose run --rm app php artisan key:generate --show
APP_KEY=base64:CTYID1qca+Gt/F1sUhRvr/a+6maPsb1mrrb2n4stYzA=
APP_DEBUG=false
APP_URL=http://192.168.1.101:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

# stderr keeps the logs in `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# PostgreSQL, as seen from the app container.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=darmois
DB_USERNAME=darmois
DB_PASSWORD=change-me-before-you-deploy

# PostgreSQL container initialisation. These only take effect the first time
# the db-data volume is created, and must match DB_DATABASE / DB_USERNAME /
# DB_PASSWORD above.
POSTGRES_DB=darmois
POSTGRES_USER=darmois
POSTGRES_PASSWORD=change-me-before-you-deploy

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
