APP_NAME=DARMOIS
APP_ENV=production
# Generate this on the server: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# Replace with the server's address if you open the app from another machine,
# for example http://192.168.1.101:8000
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Bind `php artisan serve` to every network interface, so a plain
# `php artisan serve` is reachable from other machines with no extra flags.
# Remember to open the port in the firewall:
#   sudo ufw allow 8000/tcp
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# SQLite lives at database/database.sqlite by default.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Nothing in this app queues work yet. `sync` keeps `php artisan serve` as the
# only process you need to run; switch to `database` if you add queued jobs.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
